{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["react", "node"],
    "customConditions": ["browser"],
    "moduleSuffixes": [".web", ""],
    "jsx": "react-jsx"
  },
  "include": ["web/main.tsx", "src/web/react-native-web.d.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.native.ts", "android", "ios"]
}
