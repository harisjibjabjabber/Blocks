// Included inside bs_synth. NoteRack owns requested and effective configs;
// updating numeric recipes cannot rewire a chain or cancel held notes.
 void applyNoteModulation(){auto c=noteRack.config();for(unsigned i=0;i<c.count;++i){auto&b=c.blocks[i];if(b.type==BS_NOTE_DROP){if(b.primary)continue;b.drop_amount=float(workspaceValue(b.drop_amount,6,b.id,0));b.drop_time=float(workspaceValue(b.drop_time,6,b.id,1));b.drop_bend=float(workspaceValue(b.drop_bend,6,b.id,2));}else if(b.type==BS_NOTE_ARP){b.perf.bpm=float(workspaceValue(b.perf.bpm,6,b.id,3));double offset=workspaceOffset(6,b.id,4);if(offset!=0){const auto&list=blocks_detail::delayDivisions;auto n=blocks_detail::steppedIndex(blocks_detail::divisionIndex(list,b.perf.division,b.perf.triplet),offset,unsigned(list.size()));b.perf.division=list[n].division;b.perf.triplet=list[n].triplet;}b.perf.curl=float(workspaceValue(b.perf.curl,6,b.id,5));b.perf.gate=float(workspaceValue(b.perf.gate,6,b.id,6));}else{b.perf.strum_ms=float(workspaceValue(b.perf.strum_ms,6,b.id,7));b.perf.randomness=float(workspaceValue(b.perf.randomness,6,b.id,8));}}noteRack.configureEffective(c);}
 double noteTargetValue(unsigned id,unsigned p)const{const auto b=noteRack.effectiveBlock(id);if(!b.id)return std::numeric_limits<double>::quiet_NaN();if(b.type==BS_NOTE_DROP&&!b.primary&&p<3){const double x[]={b.drop_amount,b.drop_time,b.drop_bend};return x[p];}if(b.type==BS_NOTE_ARP){if(p==3)return b.perf.bpm;if(p==4)return blocks_detail::divisionIndex(blocks_detail::delayDivisions,b.perf.division,b.perf.triplet);if(p==5)return b.perf.curl;if(p==6)return b.perf.gate;}if(b.type==BS_NOTE_STRUM){if(p==7)return b.perf.strum_ms;if(p==8)return b.perf.randomness;}return std::numeric_limits<double>::quiet_NaN();}
